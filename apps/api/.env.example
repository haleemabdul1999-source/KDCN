# KDCN API — local development defaults. Copy to .env. See docs/ENVIRONMENT.md for every variable.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://kdcn:kdcn@localhost:5432/kdcn
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=dev-only-app-secret-change-me-0123456789abcdef

# mock = deterministic test provider (no money moves). paystack requires PAYSTACK_SECRET_KEY.
PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=sk_test_xxx

STORAGE_LOCAL_DIR=./storage
JOBS_ENABLED=true

# Seed (development only)
SEED_ADMIN_EMAIL=admin@demo.kdcn.ng
SEED_ADMIN_PASSWORD=AdminPassword123!
# Fixed TOTP secret so the dev admin can sign in; add it to an authenticator app. NEVER set in production.
SEED_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
SEED_DEMO=true
