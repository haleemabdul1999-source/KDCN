{
  "name": "kdcn",
  "private": true,
  "description": "Kaduna Digital Commerce Network — multi-merchant digital commerce platform (modular monolith)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @kdcn/api test",
    "test:e2e": "pnpm --filter @kdcn/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.3.3"
  }
}
